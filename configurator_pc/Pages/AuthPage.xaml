<Page x:Class="configurator_pc.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:configurator_pc.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">


    <Border Background="#ff1851">
        <Grid>
            <Border Width="800" Background="White" Padding="40,30,40,30" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="40" FontSize="14" Padding="10,8" BorderThickness="1" Margin="0,0,0,15"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="40" FontSize="14" Padding="10,8" BorderThickness="1" Margin="0,0,0,25"/>

                    <Button x:Name="btnLogin" Content="Войти" Height="45" Background="#ff1851" Foreground="White" FontSize="16" Click="btnLogin_Click">
                    </Button>

                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
                        Нет аккаунта ? <Hyperlink Click="Register_Click" TextDecorations="None">Зарегистрироваться</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
