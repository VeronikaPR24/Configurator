<Page x:Class="configurator_pc.Pages.RegistrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:configurator_pc.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrPage">

    <Border Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ff1851">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="40">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Создать аккаунт" FontSize="26" FontWeight="Bold" Margin="0,0,0,30"/>

                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="40" FontSize="14" Padding="10,8" BorderThickness="1" Margin="0,0,0,15"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="40" FontSize="14" Padding="10,8" BorderThickness="1" Margin="0,0,0,15"/>

                    <TextBlock Text="Повторите пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtConfirmPassword" Height="40" FontSize="14" Padding="10,8" BorderThickness="1" Margin="0,0,0,25"/>

                    <Button x:Name="btnRegister" Content="Зарегистрироваться" Height="45" Background="#ff1851" Foreground="White" FontSize="16" Click="btnRegister_Click"/>

                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
                        Уже есть аккаунт? <Hyperlink Click="Auth_Click" TextDecorations="None">Войти</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
